# ---- Required -------------------------------------------------------------
DATABASE_URL="postgresql://momentica:momentica@localhost:55432/momentica?schema=public"
# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
# Where the rendered experiences are served from (no trailing slash)
PUBLIC_WEB_ORIGIN="https://momentica.ferbotz.com"

# ---- Optional -------------------------------------------------------------
NODE_ENV="development"
PORT="3000"
# Access-token lifetime. "never" (the default, HOA protocol 04) signs tokens with
# no expiry; a duration like "30d" reinstates one. Rotating JWT_SECRET is the only
# way to invalidate issued tokens, and it signs every user out at once.
JWT_EXPIRES_IN="never"
# Extra browser origins allowed to call this API, comma-separated
CORS_ORIGINS="http://localhost:5173"

# ---- Media storage (all five or none; absent => image endpoints return 503) --
AWS_REGION=""
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# ---- Billing (all three or none; absent => billing endpoints return 503) -----
REVENUECAT_API_KEY=""
REVENUECAT_PROJECT_ID=""
REVENUECAT_WEBHOOK_SECRET=""

# ---- AI assist (optional) ---------------------------------------------------
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5"

# ---- Remote config (optional) ----------------------------------------------
# A JSON patch over the defaults served by GET /api/v1/config, for every caller —
# flip a switch without a deploy (edit, then recreate the container). Keys must
# exist in src/modules/remoteConfig/remoteConfig.defaults.ts with the same types,
# or the app refuses to start. One line, no quotes around the JSON.
# REMOTE_CONFIG_OVERRIDES={"maintenance":{"enabled":true,"message":"Back in 10 minutes"}}

# ---- Development only -------------------------------------------------------
# Enables POST /api/v1/auth/test-login. The app refuses to boot if this is set
# while NODE_ENV=production.
TEST_LOGIN_SECRET=""
